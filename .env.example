# Supabase (cliente del frontend — claves públicas)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Secretos de Edge Functions (configurar en Supabase → Edge Functions → Secrets) ---
# NO van en este archivo; se listan solo como referencia.
#   SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY  (automáticos)
#   APPS_SCRIPT_URL        (URL del Web App de Google Apps Script)
#   APPS_SCRIPT_SECRET     (secreto compartido con Apps Script)
#   ALLOWED_ORIGINS        (opcional) orígenes permitidos por CORS, separados por coma.
#                          Ej: https://inmobiliaria-caribe.com,http://localhost:5173

# --- Google Apps Script (se configura en el script, vía propiedades) ---
#   SCRIPT_SECRET          Propiedades del proyecto en script.google.com
